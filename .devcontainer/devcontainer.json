{
    "name": "Resume AI Dev",
    "dockerFile": "Dockerfile",
    "context": "..",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "ms-azuretools.vscode-docker",
                "charliermarsh.ruff"
            ]
        }
    },
    "forwardPorts": [8000],
    "postCreateCommand": "pip install --upgrade pip",
    "remoteUser": "root"
}